<?xml version="1.0"?>
<!-- Только поиск мёртвого кода. tests не включать: код ради теста должен оставаться мёртвым. -->
<psalm errorLevel="8" findUnusedCode="true" findUnusedBaselineEntry="false" resolveFromConfigFile="false" xmlns="https://getpsalm.org/schema/config">
  <projectFiles>
    <file name=".psalm-entries.php"/>
    <directory name="app"/>
    <directory name="routes"/>
    <directory name="config"/>
    <directory name="bootstrap"/>
    <directory name="database/seeders"/>
    <directory name="database/factories"/>
    <!-- src каждого пакета монорепо -->
    <ignoreFiles><directory name="vendor"/><directory name="bootstrap/cache"/></ignoreFiles>
  </projectFiles>
</psalm>
